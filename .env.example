# Qloo hackathon key (required). Keys only work against the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent LLM (optional; without it the app uses deterministic evidence rules).
# Any OpenAI-compatible endpoint works. Recommended free option: Google Gemini (key from aistudio.google.com).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
# Free tiers allow a few requests per minute and a few dozen per day, per model. When a model is rate limited,
# overloaded or hanging, the next one in this list answers instead.
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
LLM_REASONING_EFFORT=low
# Seconds before a model counts as hanging (the first agent turn always gets 25 s).
LLM_TIMEOUT=45
# Leave unset for Gemini 3 models (they are tuned for the default temperature).
LLM_TEMPERATURE=
# A second free provider whose models follow the chain above (optional; key from console.groq.com/keys, no card).
# Free tier: 1,000 requests a day and 8,000 tokens a minute per model; long agent turns are cut to fit.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Seconds the agent may wait for a resting model to come back before the evidence rules take over.
LLM_MAX_WAIT=40
# Agent answers are reused while a site's Qloo evidence is unchanged, to save the free quota. Set to 0 to disable.
AGENT_CACHE=1

# Most launch kits the server builds per day (UTC); each asks the model for its ad copy. Visitors get 12 an hour each.
KIT_DAILY_LIMIT=60

# Where users, surveys, design sheets and launch kits are kept (optional). Empty: a SQLite file, .data/walkin.db.
# On a host whose disk does not survive a restart (Render's free plan), use Postgres, e.g. Neon's free tier. Neon's
# direct and pooled ("-pooler" in the host) connection strings both work as copied:
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
# Surveys are deleted after this many days, with their kits, unless a signed-in user keeps them in My places.
SURVEY_RETENTION_DAYS=60
# Finished surveys anyone can open before running their own (comma-separated survey ids, the id in /s/{id}); they are
# listed on the first screen and at /examples with their launch kit and report, and are never deleted.
EXAMPLES=

# The app's public address (https://...). When it is https, cookies are Secure and the development login is off.
PUBLIC_URL=

# Sign in with Google (optional; without it nobody can sign in, so nothing is kept in My places).
# console.cloud.google.com > Google Auth Platform > Clients > Create client > Web application; add the site's address
# (and http://localhost:5173 for development) to Authorized JavaScript origins. Only the client ID is needed.
GOOGLE_CLIENT_ID=
# Days a sign-in lasts; using the app renews it, at most once a day.
SESSION_DAYS=30
# Development only: POST /api/auth/dev signs in with any email, without Google. Ignored when PUBLIC_URL is https.
AUTH_DEV_LOGIN=false
# Other origins whose pages may POST to the API (comma-separated), besides PUBLIC_URL's and the server's own. In
# development (PUBLIC_URL not https) http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
ALLOWED_ORIGINS=
# Behind the Cloudflare Pages front door (frontend/functions): a long random secret set on both sides. With it, the
# visitor's address the front door sends (X-Client-IP) is trusted for rate limits; empty means no front door.
PROXY_SECRET=
# A free Render instance sleeps after 15 idle minutes and takes about 40 seconds to wake. The app visits this address
# every 5 minutes so it never does: the front door's health check, https://<the Pages address>/api/health. Leave it empty
# elsewhere, and for a second free service sharing the workspace's 750 free hours a month.
KEEP_AWAKE_URL=

# Walk-in Founders: neighbors pledge with PayPal to back a business before the lease is signed.
# PayPal REST app (developer.paypal.com > Apps & Credentials). The sandbox until PAYPAL_ENV=live; without the keys
# nobody can pledge and the pages say why. The sandbox app's business account must be able to take payments (a US
# business account does; some countries' accounts cannot capture).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The webhook registered for this server's address: python docs/founders/setup_paypal_webhook.py https://<backend>
# writes it here. Without it POST /api/paypal/webhook does not exist; settlement still keeps everything in step.
PAYPAL_WEBHOOK_ID=
# A long random secret for POST /api/cron/settle (header X-Cron-Secret), called by .github/workflows/settle.yml with
# the repository secrets BACKEND_URL and CRON_SECRET. Without it that endpoint does not exist.
CRON_SECRET=
# Seconds between the in-app settlement passes, which settle campaigns past their close and pay their owners (0: off).
SETTLE_EVERY_S=180
# For the judging weeks, once Qloo's hackathon key is switched off: GET /api/run answers 503 and the web app shows the
# surveyed storefronts instead of the survey button.
SURVEYS_PAUSED=false
# Only for docs/founders/sandbox_money_flows.py and e2e_campaign.py, which approve pledges as sandbox buyers in a
# headless browser (developer.paypal.com > Sandbox accounts, US personal accounts). Never a real account. A goal counts
# different PayPal accounts, so the end-to-end run needs three: PAYPAL_SANDBOX_BUYERS="email:password;email:password;
# email:password" (or PAYPAL_SANDBOX_BUYER_EMAIL/_PASSWORD with _2 and _3). The payout goes to
# PAYPAL_SANDBOX_PAYOUT_EMAIL (another sandbox account than the app's own; the first buyer by default).
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_BUYERS=
PAYPAL_SANDBOX_PAYOUT_EMAIL=
