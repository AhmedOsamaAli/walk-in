# Qloo hackathon key (required). Keys only work against the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent LLM (optional; without it the app uses deterministic evidence rules).
# Any OpenAI-compatible endpoint works. Recommended free option: Google Gemini (key from aistudio.google.com).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
# Free tiers allow a few requests per minute and a few dozen per day, per model. When a model is rate limited,
# overloaded or hanging, the next one in this list answers instead.
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
LLM_REASONING_EFFORT=low
# Seconds before a model counts as hanging (the first agent turn always gets 25 s).
LLM_TIMEOUT=45
# Leave unset for Gemini 3 models (they are tuned for the default temperature).
LLM_TEMPERATURE=
# Agent answers are reused while a site's Qloo evidence is unchanged, to save the free quota. Set to 0 to disable.
AGENT_CACHE=1

# Renders of each concept: the full interior and the shopfront with its sign (optional), tried in the order listed.
# cloudflare = Workers AI, free daily allowance of 10,000 neurons, no card needed (dash.cloudflare.com -> AI ->
#              Workers AI -> Use REST API). FLUX.1 schnell: square, ~130 free a day. Set CLOUDFLARE_IMAGE_MODEL to
#              @cf/black-forest-labs/flux-2-klein-4b for 16:9 renders (~100 free a day).
# horde      = AI Horde, free volunteer GPUs (github.com/Haidra-Org/AI-Horde). No key; renders queue for 1-10 minutes.
# gemini     = Google's image models with the agent's key. Not in the free tier: needs billing. IMAGE_MODEL defaults to
#              gemini-3.1-flash-image; gemini-3-pro-image is sharper.
# openai     = any OpenAI-compatible images API (e.g. gpt-image-1) with IMAGE_API_KEY, IMAGE_BASE_URL and IMAGE_MODEL.
IMAGE_PROVIDER=cloudflare,horde
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Optional: a free registered AI Horde key (aihorde.net/register) can earn queue priority.
AI_HORDE_API_KEY=
IMAGE_MODEL=
# Most new renders per day (UTC); cached renders are free. Caps spending on a public demo.
IMAGE_DAILY_LIMIT=60
