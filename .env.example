# Qloo hackathon key (required). Keys only work against the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent LLM (optional; without it the app uses deterministic evidence rules).
# Any OpenAI-compatible endpoint works. Recommended free option: Google Gemini (key from aistudio.google.com).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=low
# Leave unset for Gemini 3 models (they are tuned for the default temperature).
LLM_TEMPERATURE=

# Interior images (optional).
# cloudflare = Workers AI FLUX.1 [schnell], free daily allowance (dash.cloudflare.com -> AI -> Workers AI).
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Or: IMAGE_PROVIDER=openai with IMAGE_API_KEY, IMAGE_BASE_URL and IMAGE_MODEL.
